# Environment Variables Example
# Copy this file to .env and modify the values

# Node Environment
NODE_ENV=production

# Backend API
PORT=3001

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ei_platform
DB_USER=ei_user
DB_PASSWORD=ei_password_2024

# Frontend
REACT_APP_API_URL=http://localhost:3001

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Security (add for production)
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here
